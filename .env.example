LLM_PROVIDER=gemini

GEMINI_API_KEY=

# Models
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_LARGE=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CLAUDE_API_KEY=
CLAUDE_MODEL_SMALL=claude-3-5-haiku-latest
CLAUDE_MODEL_LARGE=claude-3-5-sonnet-latest

# Feature flags
ENABLE_CACHE=false
ENABLE_RAG_SELECTION=false
ENABLE_ROUTING=false

# Cache
CACHE_SIMILARITY_THRESHOLD=0.95

# RAG
RAG_TOP_K=5

# Database
DATABASE_URL=postgresql://tokenflow:tokenflow@localhost:5433/tokenflow

# Logging
METRICS_LOG_PATH=evaluation/logs/requests.jsonl
