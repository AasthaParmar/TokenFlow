GEMINI_API_KEY=

# Models
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_LARGE=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Feature flags
ENABLE_CACHE=false
ENABLE_RAG_SELECTION=false
ENABLE_ROUTING=false

# Cache
CACHE_SIMILARITY_THRESHOLD=0.95

# RAG
RAG_TOP_K=5

# Database
DATABASE_URL=postgresql://tokenflow:tokenflow@localhost:5432/tokenflow

# Logging
METRICS_LOG_PATH=evaluation/logs/requests.jsonl
